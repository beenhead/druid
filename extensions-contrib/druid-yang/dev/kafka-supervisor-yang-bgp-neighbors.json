{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "yang_bgp_neighbors",
      "timestampSpec": {
        "column": "eventTime",
        "format": "iso"
      },
      "dimensionsSpec": {
        "useSchemaDiscovery": true,
        "dimensions": [
          "device",
          "network-instance.name",
          "neighbor-address",
          {
            "type": "long",
            "name": "peer_as"
          },
          "session_state",
          {
            "type": "long",
            "name": "established_transitions"
          },
          {
            "type": "long",
            "name": "updates_received"
          },
          {
            "type": "long",
            "name": "updates_sent"
          },
          {
            "type": "long",
            "name": "prefixes_received"
          },
          {
            "type": "long",
            "name": "prefixes_installed"
          },
          "afi_safi"
        ],
        "dimensionExclusions": [
          "kafka.timestamp",
          "kafka.topic",
          "kafka.partition",
          "kafka.offset"
        ]
      },
      "transformSpec": {
        "transforms": [
          {
            "type": "expression",
            "name": "device",
            "expression": "nvl(\"hostname\", \"kafka.key\")"
          }
        ],
        "filter": {
          "type": "not",
          "field": {
            "type": "null",
            "column": "yang-rule"
          }
        }
      },
      "granularitySpec": {
        "segmentGranularity": "hour",
        "queryGranularity": "none",
        "rollup": false
      }
    },
    "ioConfig": {
      "topic": "yang-telemetry",
      "consumerProperties": {
        "bootstrap.servers": "localhost:9092"
      },
      "useEarliestOffset": true,
      "taskCount": 1,
      "replicas": 1,
      "taskDuration": "PT1H",
      "inputFormat": {
        "type": "kafka",
        "keyFormat": {
          "type": "regex",
          "pattern": "(.*)",
          "columns": [
            "hostname"
          ]
        },
        "valueFormat": {
          "type": "yangJson",
          "rules": [
            {
              "name": "bgp-neighbors",
              "path": "network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor"
            }
          ],
          "onUnmatched": "emit",
          "flattenSpec": {
            "useFieldDiscovery": true,
            "fields": [
              {
                "type": "path",
                "name": "peer_as",
                "expr": "$.state['peer-as']"
              },
              {
                "type": "path",
                "name": "session_state",
                "expr": "$.state['session-state']"
              },
              {
                "type": "path",
                "name": "established_transitions",
                "expr": "$.state['established-transitions']"
              },
              {
                "type": "path",
                "name": "updates_received",
                "expr": "$.state.messages.received.UPDATE"
              },
              {
                "type": "path",
                "name": "updates_sent",
                "expr": "$.state.messages.sent.UPDATE"
              },
              {
                "type": "path",
                "name": "afi_safi",
                "expr": "$['afi-safis']['afi-safi'][0]['afi-safi-name']"
              },
              {
                "type": "path",
                "name": "prefixes_received",
                "expr": "$['afi-safis']['afi-safi'][0].state.prefixes.received"
              },
              {
                "type": "path",
                "name": "prefixes_installed",
                "expr": "$['afi-safis']['afi-safi'][0].state.prefixes.installed"
              }
            ]
          }
        }
      }
    },
    "tuningConfig": {
      "type": "kafka",
      "logParseExceptions": true,
      "maxSavedParseExceptions": 20
    }
  }
}